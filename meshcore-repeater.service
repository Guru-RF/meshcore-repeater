# Installed by `make install` to /etc/systemd/system/. Runs the repeater as the
# dedicated 'meshcore' system user, self-contained under /opt/meshcore-repeater
# (binary, config and the generated repeater.key all live there).
[Unit]
Description=MeshCore LoRa repeater (SX1268, ham public-only policy)

[Service]
Type=simple
User=meshcore
SupplementaryGroups=spi gpio
WorkingDirectory=/opt/meshcore-repeater
ExecStart=/opt/meshcore-repeater/meshcore-repeater -c /opt/meshcore-repeater/meshcore-repeater.conf
Restart=always
RestartSec=5
# headless: no interactive stdin CLI when run as a service (use journalctl)
StandardInput=null

[Install]
WantedBy=multi-user.target
